{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "react",
    "react-perf",
    "oxc",
    "import",
    "jsx-a11y",
    "vitest",
    "promise"
  ],
  "categories": { "correctness": "error", "perf": "error" },
  "rules": {
    "import/no-duplicates": "error",
    "eslint/no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/features", "**/features/*", "**/App", "**/App.*", "**/main", "**/main.*"],
            "message": "Application services must not import feature UI or the application entrypoint."
          }
        ]
      }
    ]
  },
  "env": { "builtin": true, "browser": true }
}
